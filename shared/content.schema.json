{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprova.mz/schema/content.schema.json",
  "title": "Conteúdo Aprova+",
  "description": "Formato do conteúdo (catálogo e questões) partilhado pelos seeds (ESTRACAO_EXAM), pelo backend e pelo importador da app. Fonte da verdade.",
  "anyOf": [
    { "$ref": "#/$defs/ficheiro_questoes" },
    { "$ref": "#/$defs/catalogo" },
    { "$ref": "#/$defs/pacote" },
    { "$ref": "#/$defs/conteudo_app" }
  ],

  "$defs": {
    "pacote": {
      "description": "pacote.json dentro do .zip de uma prova (níveis pagos + simulados). As imagens vão em imagens/ no mesmo zip.",
      "type": "object",
      "required": ["formato", "tipo", "prova", "versao", "gerado_em", "niveis_incluidos", "niveis", "simulados", "conteudo"],
      "properties": {
        "formato": { "const": 1 },
        "tipo": { "const": "pacote" },
        "prova": { "$ref": "#/$defs/codigo" },
        "versao": { "type": "integer", "minimum": 1 },
        "gerado_em": { "type": "string" },
        "niveis_incluidos": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 10 } },
        "niveis": { "type": "array", "items": { "$ref": "#/$defs/nivel" } },
        "simulados": { "type": "array", "items": { "$ref": "#/$defs/simulado" } },
        "conteudo": { "$ref": "#/$defs/ficheiro_questoes" }
      }
    },

    "conteudo_app": {
      "description": "assets/content/conteudo.json do APK: catálogo, preços, níveis e as questões grátis (níveis 1–2). Imagens em assets/content/imagens/.",
      "type": "object",
      "required": ["formato", "tipo", "versao", "gerado_em", "meta", "catalogo", "niveis", "produtos", "simulados", "exames"],
      "properties": {
        "formato": { "const": 1 },
        "tipo": { "const": "conteudo_app" },
        "versao": { "type": "integer" },
        "gerado_em": { "type": "string" },
        "meta": {
          "type": "object",
          "required": ["nota_minima_padrao", "niveis_gratis"],
          "properties": {
            "nota_minima_padrao": { "type": "integer", "minimum": 0, "maximum": 100 },
            "niveis_gratis": { "type": "integer", "minimum": 0, "maximum": 10 },
            "inclui_revistas": { "type": "boolean", "description": "true = exportado para desenvolvimento com questões não publicadas" }
          }
        },
        "catalogo": { "$ref": "#/$defs/catalogo" },
        "niveis": { "type": "array", "items": { "$ref": "#/$defs/nivel" } },
        "produtos": { "type": "array", "items": { "$ref": "#/$defs/produto" } },
        "simulados": { "type": "array", "items": { "$ref": "#/$defs/simulado" } },
        "exames": { "type": "array", "items": { "$ref": "#/$defs/ficheiro_questoes" } }
      }
    },

    "nivel": {
      "type": "object",
      "required": ["prova", "numero", "titulo"],
      "properties": {
        "prova": { "$ref": "#/$defs/codigo" },
        "numero": { "type": "integer", "minimum": 1, "maximum": 10 },
        "titulo": { "type": "string" },
        "descricao": { "type": ["string", "null"] },
        "nota_minima": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "null = usar meta.nota_minima_padrao" }
      }
    },

    "simulado": {
      "type": "object",
      "required": ["codigo", "titulo", "duracao_min", "num_perguntas", "gratuito"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "prova": { "type": ["string", "null"], "description": "simulado de uma disciplina" },
        "oferta": { "type": ["string", "null"], "description": "simulado completo de um curso" },
        "titulo": { "type": "string" },
        "duracao_min": { "type": "integer", "minimum": 1 },
        "num_perguntas": { "type": "integer", "minimum": 1 },
        "gratuito": { "type": "boolean" }
      }
    },

    "produto": {
      "type": "object",
      "required": ["codigo", "nome", "tipo", "preco_mt", "provas"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "nome": { "type": "string" },
        "descricao": { "type": ["string", "null"] },
        "tipo": { "enum": ["niveis", "simulados"] },
        "preco_mt": { "type": "integer", "minimum": 0 },
        "epoca": { "type": ["string", "null"] },
        "ordem": { "type": "integer" },
        "provas": { "$ref": "#/$defs/lista_texto" }
      }
    },

    "codigo": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$" },
    "texto_opcional": { "type": ["string", "null"] },
    "lista_texto": { "type": "array", "items": { "type": "string" } },

    "catalogo": {
      "description": "Um ou mais tipos de catálogo num só ficheiro. Os seeds usam um ficheiro por tipo (instituicoes.json = só a lista).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "grupos_exame": { "type": "array", "items": { "$ref": "#/$defs/grupo_exame" } },
        "instituicoes": { "type": "array", "items": { "$ref": "#/$defs/instituicao" } },
        "disciplinas": { "type": "array", "items": { "$ref": "#/$defs/disciplina" } },
        "temas": { "type": "array", "items": { "$ref": "#/$defs/tema" } },
        "provas": { "type": "array", "items": { "$ref": "#/$defs/prova" } },
        "cursos": { "type": "array", "items": { "$ref": "#/$defs/curso" } }
      }
    },

    "grupo_exame": {
      "type": "object",
      "required": ["codigo", "nome"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "nome": { "type": "string", "minLength": 1 },
        "instituicoes": { "$ref": "#/$defs/lista_texto" },
        "pasta_origem": { "type": "string" },
        "tem_gabarito": { "type": "boolean" }
      }
    },

    "instituicao": {
      "type": "object",
      "required": ["codigo", "sigla", "nome", "grupo_exame"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "sigla": { "type": "string", "minLength": 1 },
        "nome": { "type": "string", "minLength": 1 },
        "grupo_exame": { "$ref": "#/$defs/codigo" },
        "provincias": { "$ref": "#/$defs/lista_texto" },
        "edital": {
          "type": ["object", "null"],
          "properties": { "ficheiro": { "type": "string" }, "ano": { "type": ["integer", "null"] } }
        }
      }
    },

    "disciplina": {
      "type": "object",
      "required": ["codigo", "nome"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "nome": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/lista_texto" },
        "icone": { "type": ["string", "null"] }
      }
    },

    "tema": {
      "type": "object",
      "required": ["codigo", "disciplina", "nome"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "disciplina": { "$ref": "#/$defs/codigo" },
        "nome": { "type": "string", "minLength": 1 }
      }
    },

    "prova": {
      "description": "Grupo de exame + disciplina (+ variante). Ex.: UEM-MAT2.",
      "type": "object",
      "required": ["codigo", "grupo_exame", "disciplina", "nome"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "grupo_exame": { "$ref": "#/$defs/codigo" },
        "disciplina": { "$ref": "#/$defs/codigo" },
        "variante": { "type": ["string", "null"] },
        "tipo": { "enum": ["escrita", "pratica"] },
        "nome": { "type": "string", "minLength": 1 },
        "duracao_min": { "type": ["integer", "null"], "minimum": 1 },
        "num_questoes": { "type": ["integer", "null"], "minimum": 1 },
        "num_alternativas": { "type": ["integer", "null"], "minimum": 2, "maximum": 5 },
        "nota": { "type": "string" }
      }
    },

    "curso": {
      "description": "Curso numa instituição (no backend chama-se oferta).",
      "type": "object",
      "required": ["codigo", "slug", "instituicao", "nome", "provas"],
      "properties": {
        "codigo": { "$ref": "#/$defs/codigo" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "instituicao": { "$ref": "#/$defs/codigo" },
        "curso": { "$ref": "#/$defs/codigo", "description": "curso genérico (ex.: ENGENHARIA-INFORMATICA); calculado do nome se faltar" },
        "icone": { "type": ["string", "null"] },
        "nome": { "type": "string", "minLength": 1 },
        "nome_original": { "type": "string" },
        "faculdade": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/lista_texto" }] },
        "local": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/lista_texto" }] },
        "regimes": { "$ref": "#/$defs/lista_texto" },
        "provas": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/codigo" },
              {
                "type": "object",
                "required": ["prova"],
                "properties": {
                  "prova": { "$ref": "#/$defs/codigo" },
                  "peso": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
                }
              }
            ]
          }
        },
        "modelo_exame": { "type": ["string", "null"] },
        "vagas": { "type": "array" },
        "fonte": { "type": "object" }
      }
    },

    "ficheiro_questoes": {
      "description": "Um ficheiro por exame: questoes/<GRUPO>/<PROVA>/<ANO>[-VARIANTE].json",
      "type": "object",
      "additionalProperties": false,
      "required": ["prova", "questoes"],
      "properties": {
        "prova": { "$ref": "#/$defs/codigo" },
        "fonte": {
          "type": "object",
          "properties": {
            "ficheiro": { "type": "string" },
            "ano": { "type": ["integer", "null"] },
            "variante": { "type": ["string", "null"] },
            "epoca": { "type": ["string", "null"] },
            "gabarito_ficheiro": { "type": ["string", "null"] },
            "paginas": { "type": "string" },
            "nota": { "type": "string" }
          }
        },
        "textos_base": {
          "description": "Textos de leitura partilhados, por id local (ex.: texto-1).",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/texto_base" }
        },
        "questoes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/questao" } }
      }
    },

    "texto_base": {
      "type": "object",
      "required": ["texto"],
      "properties": {
        "titulo": { "type": ["string", "null"] },
        "texto": { "type": "string", "minLength": 1 },
        "fonte": { "type": ["string", "null"] }
      }
    },

    "questao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codigo", "tipo", "enunciado", "alternativas", "resposta", "explicacao"],
      "properties": {
        "codigo": {
          "description": "Estável: nunca muda nem se reutiliza. Ex.: UEM-MAT2-2025-005",
          "type": "string",
          "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3,4}$"
        },
        "numero_original": { "type": ["integer", "null"], "minimum": 1 },
        "pagina": { "type": ["integer", "null"], "minimum": 1 },
        "tipo": { "enum": ["escolha_multipla", "verdadeiro_falso"] },
        "tema": { "type": ["string", "null"] },
        "texto_base": { "type": ["string", "null"] },
        "enunciado": { "type": "string", "minLength": 1, "description": "Markdown simples + LaTeX ($...$ / $$...$$)" },
        "imagens": { "$ref": "#/$defs/lista_texto" },
        "dica": { "type": ["string", "null"], "description": "Opcional. Não penaliza o estudante." },
        "ano": { "type": ["integer", "null"], "description": "Ano do exame de origem (nos seeds vem em fonte.ano do ficheiro)." },
        "alternativas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["letra", "texto"],
            "properties": {
              "letra": { "type": "string", "pattern": "^([A-E]|V|F)$" },
              "texto": { "type": ["string", "null"] },
              "imagem": { "type": ["string", "null"] }
            }
          }
        },
        "resposta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["letra"],
          "properties": {
            "letra": { "type": ["string", "null"], "pattern": "^([A-E]|V|F)$" },
            "origem": { "enum": ["gabarito_oficial", "proposta_ia", null] },
            "confianca": { "enum": ["alta", "media", "baixa", null] }
          }
        },
        "explicacao": {
          "type": "object",
          "additionalProperties": false,
          "required": ["texto"],
          "properties": {
            "texto": { "type": ["string", "null"] },
            "origem": { "type": ["string", "null"] },
            "revisto": { "type": "boolean" }
          }
        },
        "dificuldade": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "nivel": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 },
        "estado": {
          "description": "Seeds: extraida → revista → aprovada (ou removida). Backend: rascunho → revista → publicada.",
          "enum": ["extraida", "revista", "aprovada", "removida", "rascunho", "publicada"]
        },
        "alertas": { "$ref": "#/$defs/lista_texto" }
      }
    }
  }
}
