# Copiar para .env e preencher. O .env NUNCA vai para o Git.

# SQLite (desenvolvimento). Caminho relativo à pasta prisma/.
DATABASE_URL="file:./dev.db"
# MySQL (produção), depois de mudar o provider em prisma/schema.prisma:
# DATABASE_URL="mysql://utilizador:password@localhost:3306/aprova"

PORT=3000
NODE_ENV=development

# Segredo das sessões do admin (texto aleatório longo).
# PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
SESSION_SECRET=troca-isto-por-um-segredo-longo

# Primeiro admin, criado por `npm run db:seed`.
ADMIN_EMAIL=admin@aprova.mz
ADMIN_PASSWORD=troca-esta-password

# Onde ficam as imagens das questões e os pacotes publicados.
STORAGE_DIR=./storage

# Regras de conteúdo
NOTA_MINIMA_PADRAO=70
NIVEIS_GRATIS=2

# ── Activação por código e licenças (Etapa 3) ──
# Gerar com:  npm run chaves:gerar -- --pepper
# Segredo do hash dos códigos. NÃO mudar depois de gerar códigos (deixariam de ser reconhecidos).
CODIGO_PEPPER=
# Ed25519. A privada nunca sai do servidor; a pública vai para a app.
# Trocar as chaves invalida as licenças já emitidas.
LICENCA_CHAVE_PRIVADA=
LICENCA_CHAVE_PUBLICA=
# Validade por omissão dos códigos (fim da época de exames), AAAA-MM-DD
CODIGOS_VALIDADE_PADRAO=2027-03-31
# Tentativas de activação por hora (por IP e por dispositivo)
ACTIVACAO_LIMITE_HORA=5

# Contactos mostrados na app (paywall), via GET /api/v1/catalogo
CONTACTO_MPESA=84 000 0000
CONTACTO_EMOLA=86 000 0000
CONTACTO_WHATSAPP=84 000 0000
CONTACTO_NOME_CONTA=Aprova+
