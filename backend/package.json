{
  "name": "aprova-backend",
  "version": "1.0.0",
  "description": "Aprova+ — API e admin (Express + Prisma)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "importar": "tsx scripts/importar.ts",
    "exportar:app": "tsx scripts/exportar-app.ts",
    "chaves:gerar": "tsx scripts/gerar-chaves.ts",
    "produtos:padrao": "tsx scripts/produtos-padrao.ts",
    "provas:partilhar": "tsx scripts/provas-partilhar.ts",
    "imagens:optimizar": "tsx scripts/imagens-optimizar.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.5.18",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "katex": "^0.16.47",
    "multer": "^2.5.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp": false
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
